# Copy to keystore.properties (git-ignored) and fill in real values, or set the
# equivalent HKKBD_* environment variables. Prefer an absolute path outside this
# repository for the upload keystore.
storeFile=/absolute/path/outside/repo/hk-mixed-keyboard-upload.jks
storePassword=CHANGE_ME
keyAlias=hkmixedkeyboard
keyPassword=CHANGE_ME
