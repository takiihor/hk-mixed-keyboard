    {
      "buffer": "唔該",
      "expected": {
        "cnExactParsed": false,
        "cnHasPhraseMatch": true,
        "cnPrefixParsed": false,
        "candidateCode": "roio",
        "candidateType": "PHRASE",
        "isHkCore": true,
        "notes": "HK core phrase 'thank you / excuse me'. Quick phrase code = Quick(唔)+Quick(該)."
      }
    },
    {
      "buffer": "我哋",
      "expected": {
        "cnExactParsed": false,
        "cnHasPhraseMatch": true,
        "cnPrefixParsed": false,
        "candidateCode": "qorp",
        "candidateType": "PHRASE",
        "isHkCore": true,
        "notes": "HK Cantonese 'we/us'. Quick phrase code = Quick(我)+Quick(哋)."
      }
