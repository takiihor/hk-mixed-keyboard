      }
    },
    {
      "buffer": "send",
      "expected": {
        "cnExactParsed": false,
        "cnHasPhraseMatch": false,
        "cnPrefixParsed": false,
        "enIsWord": true,
        "enStrongPrefix": false,
        "notes": "Common English verb; no Quick code match; should commit as EN_LITERAL on Space."
      }
    },
    {
      "buffer": "ok",
      "expected": {
        "cnExactParsed": true,
        "cnHasPhraseMatch": false,
        "cnPrefixParsed": false,
        "enIsWord": true,
        "enStrongPrefix": false,
        "notes": "Collision case: 'ok' has Quick character match AND is on SHORT_WHITELIST. tieBreak favours EN_LITERAL."
      }
    },
    {
      "buffer": "go",
      "expected": {
        "cnExactParsed": true,
        "cnHasPhraseMatch": false,
        "cnPrefixParsed": false,
        "enIsWord": true,
        "enStrongPrefix": false,
        "notes": "Collision case: 'go' has Quick match (在) AND is an English word. tieBreak required."
      }
    },
    {
      "buffer": "mtr",
      "expected": {
        "cnExactParsed": false,
        "cnHasPhraseMatch": false,
        "cnPrefixParsed": true,
        "enIsWord": true,
        "enStrongPrefix": false,
        "enCanonical": "MTR",
        "notes": "SHORT_WHITELIST: mtr → MTR. Prefix-only Chinese; commit as canonical EN_LITERAL."
      }
    },
    {
      "buffer": "我",
      "expected": {
        "cnExactParsed": true,
        "cnHasPhraseMatch": false,
        "cnPrefixParsed": false,
        "candidateCode": "qo",
        "candidateType": "CHAR",
        "isHkCore": false,
        "notes": "Direct Chinese character input. Quick code QO (手人). Confirms reverse-lookup capability."
      }
    },
    {
      "buffer": "你",
      "expected": {
        "cnExactParsed": true,
        "cnHasPhraseMatch": false,
        "cnPrefixParsed": false,
        "candidateCode": "oi",
