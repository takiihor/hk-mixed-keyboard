        "isHkCore": false
      }
    },
    {
      "buffer": "唔",
      "expected": {
        "cnExactParsed": true,
        "cnHasPhraseMatch": false,
        "cnPrefixParsed": false,
        "candidateCode": "ro",
        "candidateType": "CHAR",
        "isHkCore": true,
        "notes": "HK core Cantonese negative particle. Must rank first in candidates."
      }
    },
    {
      "buffer": "嘅",
      "expected": {
        "cnExactParsed": true,
        "cnHasPhraseMatch": false,
        "cnPrefixParsed": false,
        "candidateCode": "rv",
        "candidateType": "CHAR",
        "isHkCore": true,
        "notes": "HK core possessive particle. Quick code RV (口女)."
